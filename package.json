{
  "name": "axiom01",
  "version": "3.2.2",
  "description": "Semantic-first UI framework with professional design system, animations, utilities, and components",
  "license": "MIT",
  "author": "Sol Roth Media",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sol-Roth-Media/axiom01.git"
  },
  "bugs": {
    "url": "https://github.com/Sol-Roth-Media/axiom01/issues"
  },
  "homepage": "https://sol-roth-media.github.io/axiom01/",
  "keywords": [
    "css",
    "framework",
    "design-system",
    "semantic",
    "components",
    "ui",
    "accessibility",
    "wcag"
  ],
  "main": "css/axiom.min.css",
  "style": "css/axiom.min.css",
  "files": [
    "css/axiom.css",
    "css/axiom.min.css",
    "css/axiom-core.css",
    "css/axiom-core.min.css",
    "css/axiom-audio.css",
    "css/axiom-audio.min.css",
    "css/axifonts.css",
    "fonts",
    "css/axicons.css",
    "css/_variables.css",
    "css/_animations.css",
    "css/_utilities.css",
    "css/_components.css",
    "css/axiom_config.css",
    "js/axiom.js",
    "js/axiom.min.js",
    "js/axiom-audio.js",
    "js/axicons-base.js",
    "js/axicons-premium.js",
    "js/axicons-premium-variants.js",
    "js/axicons-luxe.js",
    "js/render-icons.js",
    "packages/core",
    "packages/audio",
    "README.md",
    "CHANGELOG.md",
    "release-info.json",
    "version.txt",
    "LICENSE"
  ],
  "scripts": {
    "build:css": "python3 scripts/build_unified_css.py",
    "minify:js": "python3 scripts/minify_js.py",
    "build": "npm run build:css && npm run minify:js && python3 scripts/build_release_dist.py",
    "audit:pre-release": "python3 scripts/pre_release_audit.py",
    "audit:philosophy:report": "python3 scripts/axiom_philosophy_audit.py",
    "audit:philosophy": "python3 scripts/axiom_philosophy_audit.py --enforce",
    "audit:runtime-loader": "python3 scripts/runtime_loader_syntax_gate.py",
    "audit:runtime-loader-failures": "python3 scripts/runtime_loader_failure_smoke.py",
    "audit:critical-interactions": "python3 scripts/critical_interaction_smoke.py",
    "audit:gestures": "python3 scripts/gesture_regression_smoke.py",
    "audit:a11y-smoke": "python3 scripts/accessibility_smoke.py",
    "test": "npm run audit:pre-release && npm run audit:philosophy && npm run audit:runtime-loader && npm run audit:runtime-loader-failures && npm run audit:critical-interactions && npm run audit:gestures && npm run audit:a11y-smoke",
    "update-release": "node scripts/update-release-info.js"
  }
}
