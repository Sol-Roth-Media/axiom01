<?php

/**
 * @file
 * Functions to support theming in the Axiom01 Drupal theme.
 *
 * CLASS FILTERING PHILOSOPHY:
 * ---------------------------
 * Axiom01's semantic-first approach means we want clean HTML without
 * Drupal's visual/presentational class soup. However, Drupal's JavaScript
 * system, AJAX, BigPipe, contextual links, and many contrib modules rely
 * on specific CSS classes as JS selectors.
 *
 * We use an EXPLICIT DENYLIST of classes that are KNOWN to be purely visual
 * and safe to remove. Everything else is preserved. This ensures:
 *   - Core AJAX (js-* classes) always works
 *   - Contrib modules can add classes via render arrays
 *   - Admin toolbar, contextual links, etc. function normally
 *   - Only cosmetic Drupal classes are stripped
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;

/**
 * Denylist of class patterns that are SAFE to remove.
 *
 * These are purely visual/presentational classes from Drupal core
 * that conflict with Axiom01's semantic CSS. They carry no
 * JavaScript functionality.
 *
 * IMPORTANT: Never add js-*, use-ajax, contextual-*, or toolbar-*
 * patterns here. Those are functional.
 *
 * @return array
 *   Array of regex patterns for classes safe to strip.
 */
function _axiom01_drupal_visual_class_denylist() {
  return [
    // Node visual classes (not functional).
    '/^node--type-/',
    '/^node--view-mode-/',
    '/^node--promoted$/',
    '/^node--sticky$/',
    '/^node--unpublished$/',

    // Block visual ID classes (not functional).
    '/^block--[a-z]/',

    // Field visual classes (not functional).
    '/^field--name-/',
    '/^field--type-/',
    '/^field--label-/',
    '/^field__/',

    // Comment visual classes.
    '/^comment--/',

    // Views visual classes (NOT js-view-dom-id — that's functional).
    '/^view-id-/',
    '/^view-display-id-/',

    // Input type classes replaced by Axiom01 CSS.
    '/^form-(text|email|tel|url|search|password|number|file)$/',

    // Links visual class.
    '/^inline$/',
  ];
}

/**
 * Filters an array of classes using the safe denylist.
 *
 * Removes only classes that match the denylist patterns.
 * ALL other classes — including js-*, use-ajax, contextual-*,
 * toolbar-*, and any contrib module classes — are preserved.
 *
 * @param array $classes
 *   The array of CSS classes.
 *
 * @return array
 *   Filtered array with only visual classes removed.
 */
function _axiom01_drupal_filter_classes(array $classes) {
  $denylist = _axiom01_drupal_visual_class_denylist();
  return array_values(array_filter($classes, function ($class) use ($denylist) {
    foreach ($denylist as $pattern) {
      if (preg_match($pattern, $class)) {
        return FALSE;
      }
    }
    return TRUE;
  }));
}

/* ===========================================================================
   PREPROCESS HOOKS
   =========================================================================== */

/**
 * Implements hook_preprocess_html().
 *
 * Sets color theme attribute on the <html> tag.
 */
function axiom01_drupal_preprocess_html(&$variables) {
  $color_theme = theme_get_setting('default_color_theme') ?: 'system';
  if ($color_theme !== 'system') {
    $variables['html_attributes']->setAttribute('data-color-theme', $color_theme);
  }

  $variables['attributes']['class'][] = 'axiom01';
}

/**
 * Implements hook_preprocess_page().
 */
function axiom01_drupal_preprocess_page(&$variables) {
  $variables['axiom01_color_theme'] = theme_get_setting('default_color_theme') ?: 'system';
}

/**
 * Implements hook_preprocess_node().
 *
 * Strips only visual node classes. Preserves js-* and contrib classes.
 */
function axiom01_drupal_preprocess_node(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_block().
 *
 * Strips only visual block classes. Preserves contextual link classes.
 */
function axiom01_drupal_preprocess_block(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_field().
 *
 * Strips visual field classes. Preserves any js-* or contrib classes.
 */
function axiom01_drupal_preprocess_field(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_form_element().
 *
 * Adds our semantic form-item class. Does NOT strip js-form-* classes
 * because they are functional (used by Drupal's AJAX/states system).
 */
function axiom01_drupal_preprocess_form_element(&$variables) {
  // Ensure form-item class is present for Axiom01 styling.
  $variables['attributes']['class'][] = 'form-item';
}

/**
 * Implements hook_preprocess_input().
 *
 * Maps Drupal submit buttons to Axiom01 button classes.
 * Strips only visual input-type classes (form-text, form-email, etc.)
 * but preserves ALL js-* and functional classes.
 */
function axiom01_drupal_preprocess_input(&$variables) {
  $element = $variables['element'];

  // Map Drupal submit buttons to Axiom01 button classes.
  if (isset($element['#type']) && $element['#type'] === 'submit') {
    $variables['attributes']['class'][] = 'button';
    if (isset($element['#button_type']) && $element['#button_type'] === 'primary') {
      $variables['attributes']['class'][] = 'primary';
    }
  }

  // Strip only visual input classes. Preserve js-* and everything else.
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_links().
 *
 * Strips only the 'inline' visual class from link lists.
 */
function axiom01_drupal_preprocess_links(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_image().
 *
 * Adds lazy loading by default.
 */
function axiom01_drupal_preprocess_image(&$variables) {
  if (!isset($variables['attributes']['loading'])) {
    $variables['attributes']['loading'] = 'lazy';
  }
}

/**
 * Implements hook_preprocess_table().
 */
function axiom01_drupal_preprocess_table(&$variables) {
  // Tables are wrapped in .table-responsive via the Twig template.
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Strips visual view-id/display-id classes. Preserves js-view-dom-id
 * (critical for AJAX-powered Views).
 */
function axiom01_drupal_preprocess_views_view(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/**
 * Implements hook_preprocess_comment().
 */
function axiom01_drupal_preprocess_comment(&$variables) {
  if (isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = _axiom01_drupal_filter_classes(
      $variables['attributes']['class']
    );
  }
}

/* ===========================================================================
   FORM HOOKS
   =========================================================================== */

/**
 * Implements hook_form_alter().
 *
 * Adds Axiom01 button classes to form submit actions.
 */
function axiom01_drupal_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['actions'])) {
    foreach ($form['actions'] as $key => &$action) {
      if (is_array($action) && isset($action['#type']) && $action['#type'] === 'submit') {
        $action['#attributes']['class'][] = 'button';
        if (isset($action['#button_type']) && $action['#button_type'] === 'primary') {
          $action['#attributes']['class'][] = 'primary';
        }
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Enhances the login form for Axiom01 premium styling.
 */
function axiom01_drupal_form_user_login_form_alter(&$form, FormStateInterface $form_state) {
  $form['name']['#attributes']['placeholder'] = t('Username or email');
  $form['pass']['#attributes']['placeholder'] = t('Password');
  $form['actions']['submit']['#attributes']['class'][] = 'button';
  $form['actions']['submit']['#attributes']['class'][] = 'primary';
  // Wrap in a card-like container via a prefix/suffix.
  $form['#prefix'] = '<div class="login-form-wrapper"><div class="card"><header><h2>' . t('Sign In') . '</h2></header>';
  $form['#suffix'] = '</div></div>';
}

/**
 * Implements hook_form_FORM_ID_alter() for search_block_form.
 */
function axiom01_drupal_form_search_block_form_alter(&$form, FormStateInterface $form_state) {
  $form['keys']['#attributes']['placeholder'] = t('Search...');
  $form['actions']['submit']['#value'] = t('Search');
}

/* ===========================================================================
   TEMPLATE SUGGESTIONS
   =========================================================================== */

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node.
 */
function axiom01_drupal_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'node__' . $view_mode;
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 */
function axiom01_drupal_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['#configuration']['region'])) {
    $region = $variables['elements']['#configuration']['region'];
    $suggestions[] = 'block__' . $region;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form_element.
 */
function axiom01_drupal_theme_suggestions_form_element_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#type'])) {
    $suggestions[] = 'form_element__' . $variables['element']['#type'];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page.
 *
 * Adds content-type specific page suggestions.
 */
function axiom01_drupal_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route = \Drupal::routeMatch();
  if ($node = $route->getParameter('node')) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/* ===========================================================================
   LIBRARY & CSS OVERRIDES
   =========================================================================== */

/**
 * Implements hook_page_attachments_alter().
 *
 * Removes Drupal's default CSS libraries that conflict with Axiom01.
 * Only removes libraries from themes that are NOT base theme: false safe.
 */
function axiom01_drupal_page_attachments_alter(array &$page) {
  $remove_libraries = [
    'classy/base',
    'classy/messages',
    'classy/node',
    'stable/drupal.system.modules',
  ];

  if (isset($page['#attached']['library'])) {
    $page['#attached']['library'] = array_filter(
      $page['#attached']['library'],
      function ($library) use ($remove_libraries) {
        return !in_array($library, $remove_libraries);
      }
    );
  }
}

/**
 * Implements hook_css_alter().
 *
 * Removes specific system CSS files that conflict with Axiom01 styling.
 * Does NOT remove functional CSS (only visual).
 */
function axiom01_drupal_css_alter(&$css) {
  $remove = [
    'core/themes/stable9/css/system/components/system-status-counter.css',
    'core/themes/stable9/css/system/components/system-status-report-counters.css',
    'core/themes/stable9/css/system/components/system-status-report-general-info.css',
  ];
  foreach ($remove as $path) {
    unset($css[$path]);
  }
}
