{#
/**
 * @file
 * Axiom01 override for Webform confirmation page.
 *
 * Renders as an Axiom01 success alert.
 */
#}
<div class="alert success">
  <span class="axicon render" data-name="Checkmark_circle-Luxe"></span>
  {% if message %}
    {{ message }}
  {% endif %}
</div>
{% if progress %}
  {{ progress }}
{% endif %}
{% if back_url %}
  <p>
    <a href="{{ back_url }}" class="button primary">{{ 'Back to form'|t }}</a>
  </p>
{% endif %}
