{#
/**
 * @file
 * Axiom01 override for admin pages.
 *
 * Uses a semantic grid layout for the admin dashboard.
 */
#}
<div class="admin-panel grid">
  {% for container in containers %}
    <section class="admin-section">
      {% for block in container %}
        {{ block }}
      {% endfor %}
    </section>
  {% endfor %}
</div>
