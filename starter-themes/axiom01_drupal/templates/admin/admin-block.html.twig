{#
/**
 * @file
 * Axiom01 override for admin dashboard blocks.
 *
 * Renders as Axiom01 cards for a cohesive admin experience.
 */
#}
<article class="card admin-block">
  <header>
    <h3>{{ block.title }}</h3>
  </header>
  {% if block.content %}
    {{ block.content }}
  {% else %}
    <p>{{ 'No content available.'|t }}</p>
  {% endif %}
</article>
