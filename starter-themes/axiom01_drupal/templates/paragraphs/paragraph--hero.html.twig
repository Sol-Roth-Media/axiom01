{# paragraph--hero.html.twig #}
{% block paragraph %}
  <section{{ attributes.addClass('hero').setAttribute('id', 'get-started') }}>
    {{ title_prefix }}
    {{ title_suffix }}
    <div class="container">
      <h1>{{ paragraph.field_hero_title.value }}</h1>
      <p>{{ paragraph.field_hero_tagline.value }}</p>
      <menu class="grid">
        {% if paragraph.field_hero_btn_1_text.value %}
          <a href="{{ paragraph.field_hero_btn_1_link[0].url.toString() }}" class="button primary">
            {{ paragraph.field_hero_btn_1_text.value }}
          </a>
        {% endif %}
        {% if paragraph.field_hero_btn_2_text.value %}
          <a href="{{ paragraph.field_hero_btn_2_link[0].url.toString() }}" class="button secondary">
            {{ paragraph.field_hero_btn_2_text.value }}
          </a>
        {% endif %}
      </menu>
    </div>
  </section>
{% endblock paragraph %}
