{#
/**
 * @file
 * Axiom01 override for Accordion paragraphs.
 *
 * Uses native HTML5 <details>/<summary>.
 */
#}
{% block paragraph %}
  <details{{ attributes.addClass('paragraph', 'paragraph--accordion') }}>
    {% block content %}
      {% if content.field_title|render|trim %}
        <summary>{{ content.field_title }}</summary>
      {% endif %}
      {{ content.field_body }}
    {% endblock %}
  </details>
{% endblock paragraph %}
