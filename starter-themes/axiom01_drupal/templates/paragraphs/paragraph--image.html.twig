{#
/**
 * @file
 * Axiom01 override for Image paragraphs.
 *
 * Uses semantic <figure> with <figcaption>.
 */
#}
{% block paragraph %}
  <figure{{ attributes.addClass('paragraph', 'paragraph--image') }}>
    {% block content %}
      {{ content.field_image }}
      {% if content.field_caption|render|trim %}
        <figcaption>{{ content.field_caption }}</figcaption>
      {% endif %}
    {% endblock %}
  </figure>
{% endblock paragraph %}
