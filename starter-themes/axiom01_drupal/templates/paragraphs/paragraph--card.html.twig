{# paragraph--card.html.twig #}
{% block paragraph %}
  <article{{ attributes.addClass('card') }}>
    {{ title_prefix }}
    {{ title_suffix }}
    <header>
      {% if paragraph.field_card_icon.value %}
        <div class="icon">
          <span class="axicon render" data-name="{{ paragraph.field_card_icon.value }}"></span>
        </div>
      {% endif %}
      {% if paragraph.field_card_title.value %}
        <h3>{{ paragraph.field_card_title.value }}</h3>
      {% endif %}
    </header>
    {% if paragraph.field_card_content.value %}
      <div class="card-content">
        {{ paragraph.field_card_content.value|raw }}
      </div>
    {% endif %}
    {% if paragraph.field_card_link.value %}
      <footer class="card-footer">
        <a href="{{ paragraph.field_card_link[0].url.toString() }}">{{ paragraph.field_card_link[0].title }}</a>
      </footer>
    {% endif %}
  </article>
{% endblock paragraph %}
