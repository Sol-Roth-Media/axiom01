{#
/**
 * @file
 * Axiom01 override for Text paragraphs.
 *
 * Renders as a clean semantic flow without extra wrappers.
 */
#}
{% block paragraph %}
  <section{{ attributes.addClass('paragraph', 'paragraph--text') }}>
    {% block content %}
      {{ content }}
    {% endblock %}
  </section>
{% endblock paragraph %}
