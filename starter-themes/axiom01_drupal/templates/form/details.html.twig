{#
/**
 * @file
 * Axiom01 override for details/fieldset elements.
 *
 * Uses native HTML5 <details>/<summary> for collapsible groups.
 */
#}
<details{{ attributes }}{% if not open is same as(false) %} open{% endif %}>
  {% if title %}
    <summary>{{ title }}</summary>
  {% endif %}
  {% if errors %}
    <div class="alert error">
      <p>{{ errors }}</p>
    </div>
  {% endif %}
  {% if description %}
    <small>{{ description }}</small>
  {% endif %}
  {{ children }}
  {% if value %}
    {{ value }}
  {% endif %}
</details>
