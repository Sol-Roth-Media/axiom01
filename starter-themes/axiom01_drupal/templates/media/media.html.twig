{#
/**
 * @file
 * Axiom01 override for Media entities.
 *
 * Uses semantic <figure> for all media types.
 */
#}
<figure{{ attributes.addClass('media', 'media--' ~ media.bundle()) }}>
  {{ content }}
  {% if name and not name_is_hidden %}
    <figcaption>{{ name }}</figcaption>
  {% endif %}
</figure>
