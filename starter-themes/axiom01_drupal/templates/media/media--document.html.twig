{#
/**
 * @file
 * Axiom01 override for Document media entities.
 */
#}
<article{{ attributes.addClass('card', 'media', 'media--document') }}>
  <header>
    <span class="axicon render" data-name="File-Luxe"></span>
    {% if name %}
      <h4>{{ name }}</h4>
    {% endif %}
  </header>
  {{ content.field_media_document }}
</article>
