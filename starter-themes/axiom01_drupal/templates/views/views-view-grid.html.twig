{#
/**
 * @file
 * Axiom01 override for Views grid display.
 *
 * Maps to Axiom01's semantic grid layout using CSS Grid.
 */
#}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
<div{{ attributes.addClass('grid') }}>
  {% for row in rows %}
    {% for column in row.columns %}
      <div{{ column.attributes }}>
        {{ column.content }}
      </div>
    {% endfor %}
  {% endfor %}
</div>
