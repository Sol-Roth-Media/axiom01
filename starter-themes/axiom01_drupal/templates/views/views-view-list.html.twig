{#
/**
 * @file
 * Axiom01 override for Views list output.
 *
 * Uses semantic list structure.
 */
#}
{% if title %}
  <h3>{{ title }}</h3>
{% endif %}
<{{ list.type }}{{ list.attributes }}>
  {% for row in rows %}
    <li{{ row.attributes }}>{{ row.content }}</li>
  {% endfor %}
</{{ list.type }}>
