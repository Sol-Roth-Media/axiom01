{#
/**
 * @file
 * Axiom01 override for Views output.
 *
 * Provides a clean semantic wrapper for Views displays.
 */
#}
<section{{ attributes.addClass('view') }}>
  {{ title_prefix }}
  {% if title %}
    <header>
      <h2>{{ title }}</h2>
    </header>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}

  {% if exposed %}
    <div class="view-filters">
      {{ exposed }}
    </div>
  {% endif %}

  {% if attachment_before %}
    {{ attachment_before }}
  {% endif %}

  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="alert">
      <p>{{ empty }}</p>
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}

  {% if attachment_after %}
    {{ attachment_after }}
  {% endif %}

  {% if more %}
    {{ more }}
  {% endif %}

  {% if footer %}
    <footer class="view-footer">
      {{ footer }}
    </footer>
  {% endif %}

  {% if feed_icons %}
    {{ feed_icons }}
  {% endif %}
</section>
