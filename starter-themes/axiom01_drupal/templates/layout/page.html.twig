{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Axiom01 enforces pure semantic structure, eliminating unnecessary <div> tags.
 */
#}
<header class="main" data-component="mobile-navbar">
  <nav role="navigation" aria-label="Main Navigation">
    <a href="/" class="brand" aria-label="Axiom01 Framework Home">ax[10]m</a>
    <ul class="links">
      <li><a href="/docs/components">Components</a></li>
      <li><a href="/docs/axicons">Axicons</a></li>
      <li><a href="/docs/fonts">Fonts</a></li>
    </ul>
    <div class="actions">
      {{ page.secondary_menu }}
      <button class="search toggle" aria-label="Open Search">
        <span class="axicon" aria-hidden="true"><svg viewBox="0 0 128 128" fill="none"><circle cx="52" cy="52" r="40" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/><path d="M80 80l32 32" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </button>
      <button class="theme toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <span class="axicon moon" aria-hidden="true"><svg viewBox="0 0 128 128" fill="none"><path d="M96 76a40 40 0 1 1-64-32 40 40 0 0 0 64 32z" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="axicon sun" aria-hidden="true"><svg viewBox="0 0 128 128" fill="none"><circle cx="64" cy="64" r="32" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/><path d="M64 8v16M64 104v16M24 64H8M120 64h-16M32 32l-16-16M112 112l-16-16M32 96l-16 16M112 32l-16-16" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </button>
      <button class="menu toggle" aria-label="Toggle Menu">
        <span class="axicon" aria-hidden="true"><svg viewBox="0 0 128 128" fill="none"><path d="M16 32h96M16 64h96M16 96h96" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </button>
    </div>
  </nav>
</header>

{% if page.highlighted %}
  <div class="highlighted">
    <div class="container">
      {{ page.highlighted }}
    </div>
  </div>
{% endif %}

{% if page.breadcrumb %}
  <div class="container">
    {{ page.breadcrumb }}
  </div>
{% endif %}

{% if page.sidebar_first or page.sidebar_second %}
  <div class="container">
    <div class="layout-content-sidebar grid-layout">
      {% if page.sidebar_first %}
        <aside class="sidebar-first" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      <main role="main" id="main-content">
        <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
        {{ page.help }}
        {{ page.content }}
      </main>

      {% if page.sidebar_second %}
        <aside class="sidebar-second" role="complementary">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </div>
{% else %}
  <main role="main" id="main-content">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {{ page.help }}
    {{ page.content }}
  </main>
{% endif %}

<footer class="main">
  <div class="content">
    <div class="brand">
      <a href="/" class="logo">ax[10]m</a>
      <p class="tagline">The Semantic Web, Reimagined.</p>
    </div>

    <div class="column">
      <h4>Product</h4>
      <ul>
        <li><a href="/docs/components">Components</a></li>
        <li><a href="/docs/axicons">Axicons</a></li>
        <li><a href="/docs/fonts">Fonts</a></li>
      </ul>
    </div>

    <div class="column">
      <h4>Resources</h4>
      <ul>
        <li><a href="/docs/styling-guide">Styling Guide</a></li>
        <li><a href="/docs/developer-guide">Developer Guide</a></li>
      </ul>
    </div>

    <div class="column">
      <h4>Community</h4>
      <ul>
        <li><a href="https://github.com/Sol-Roth-Media/axiom01" target="_blank" rel="noopener">GitHub Repository</a></li>
        <li><a href="https://github.com/Sol-Roth-Media/axiom01/issues" target="_blank" rel="noopener">Report Issues</a></li>
        <li><a href="https://www.solroth.com" target="_blank" rel="noopener">Creator: Sol Roth</a></li>
        <li><a href="https://www.npmjs.com/package/axiom01" target="_blank" rel="noopener">NPM Package</a></li>
      </ul>
    </div>
  </div>

  <div class="content">
    <div class="bottom">
      <p class="copyright">&copy; <span data-current-year></span> <strong>Sol Roth Media</strong>. Released under <strong>MIT License</strong>.</p>
      <ul class="legal">
        <li><a href="https://github.com/Sol-Roth-Media/axiom01" target="_blank" rel="noopener" aria-label="GitHub Repository"><span class="axicon render" data-name="GitHub"></span></a></li>
        <li><a href="https://www.npmjs.com/package/axiom01" target="_blank" rel="noopener" aria-label="NPM Package"><span class="axicon render" data-name="NPM"></span></a></li>
        <li><button id="scroll-to-top" class="scroll-top" data-scroll-top aria-label="Scroll to top"><span class="axicon render" data-name="Arrow-Up"></span></button></li>
      </ul>
    </div>
  </div>
</footer>
