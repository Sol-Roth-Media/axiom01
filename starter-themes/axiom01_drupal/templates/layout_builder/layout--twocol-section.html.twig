{#
/**
 * @file
 * Axiom01 override for Layout Builder two-column layout.
 *
 * Uses Axiom01's CSS Grid layout.
 */
#}
{% if content %}
  <section{{ attributes.addClass('layout', 'layout--twocol') }}>
    <div class="container grid">
      {% if content.first %}
        <div class="layout-region">
          {{ content.first }}
        </div>
      {% endif %}
      {% if content.second %}
        <div class="layout-region">
          {{ content.second }}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
