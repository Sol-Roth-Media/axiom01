{#
/**
 * @file
 * Axiom01 override for Layout Builder three-column layout.
 */
#}
{% if content %}
  <section{{ attributes.addClass('layout', 'layout--threecol') }}>
    <div class="container grid">
      {% if content.first %}
        <div class="layout-region">
          {{ content.first }}
        </div>
      {% endif %}
      {% if content.second %}
        <div class="layout-region">
          {{ content.second }}
        </div>
      {% endif %}
      {% if content.third %}
        <div class="layout-region">
          {{ content.third }}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
