{#
/**
 * @file
 * Axiom01 override for Layout Builder one-column layout.
 */
#}
{% if content %}
  <section{{ attributes.addClass('layout', 'layout--onecol') }}>
    <div class="container">
      {% if content.content %}
        {{ content.content }}
      {% endif %}
    </div>
  </section>
{% endif %}
