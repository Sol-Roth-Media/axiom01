{#
/**
 * @file
 * Axiom01 override for image fields.
 *
 * Uses semantic <figure> / <figcaption> elements.
 */
#}
{% for item in items %}
  <figure{{ attributes }}>
    {{ item.content }}
    {% if label and not label_hidden %}
      <figcaption>{{ label }}</figcaption>
    {% endif %}
  </figure>
{% endfor %}
