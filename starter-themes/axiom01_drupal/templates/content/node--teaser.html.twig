{#
/**
 * @file
 * Axiom01 override for node teasers, rendered as Axiom01 cards.
 */
#}
<article{{ attributes.addClass('card') }}>
  <header>
    {{ title_prefix }}
    <h3>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
    {{ title_suffix }}
    {% if display_submitted %}
      <p class="meta">
        {% trans %}By {{ author_name }} &middot; {{ date }}{% endtrans %}
      </p>
    {% endif %}
  </header>
  <div{{ content_attributes }}>
    {{ content }}
  </div>
  <footer>
    <a href="{{ url }}" class="button primary">{{ 'Read more'|t }}</a>
  </footer>
</article>
