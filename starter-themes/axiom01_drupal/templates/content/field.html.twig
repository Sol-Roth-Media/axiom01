{#
/**
 * @file
 * Axiom01 override for field output.
 *
 * Strips Drupal's excessive wrapper divs for clean semantic flow.
 */
#}
{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes }}>
      {% for item in items %}
        {{ item.content }}
      {% endfor %}
    </div>
  {% else %}
    {% for item in items %}
      {{ item.content }}
    {% endfor %}
  {% endif %}
{% else %}
  <div{{ attributes }}>
    <strong{{ title_attributes }}>{{ label }}</strong>
    {% for item in items %}
      {{ item.content }}
    {% endfor %}
  </div>
{% endif %}
