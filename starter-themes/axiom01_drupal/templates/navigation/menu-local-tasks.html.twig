{#
/**
 * @file
 * Default theme implementation to display primary and secondary local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing secondary tasks.
 *
 * Each item in these variables (primary and secondary) can be individually
 * themed in menu-local-task.html.twig.
 *
 * @ingroup themeable
 */
#}
{% if primary or secondary %}
  <div class="dropdown local-tasks-dropdown" data-component="dropdown">
    <button class="dropdown-toggle button icon-only small secondary" aria-expanded="false" aria-haspopup="menu" aria-label="Settings">
      <span class="axicon render" data-name="Settings_gear-Luxe"></span>
    </button>
    <ul class="dropdown menu" data-dropdown-menu role="menu">
      {% if primary %}
        {{ primary }}
      {% endif %}
      {% if secondary %}
        <li role="presentation"><hr></li>
        {{ secondary }}
      {% endif %}
    </ul>
  </div>
{% endif %}
