{#
/**
 * @file
 * Axiom01 override for the main navigation menu.
 *
 * Wraps the primary menu in a proper <nav> with Axiom01 navbar structure.
 */
#}
{% import _self as menus %}

{% if items %}
  <nav aria-label="{{ 'Main navigation'|t }}">
    {{ menus.menu_links(items, attributes, 0) }}
  </nav>
{% endif %}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  <ul{{ menu_level == 0 ? attributes }}>
  {% for item in items %}
    <li{{ item.attributes.addClass(item.in_active_trail ? 'active') }}>
      {{ link(item.title, item.url) }}
      {% if item.below %}
        {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
      {% endif %}
    </li>
  {% endfor %}
  </ul>
{% endmacro %}
