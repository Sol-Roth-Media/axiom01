{#
/**
 * @file
 * Axiom01 override for tables.
 *
 * Wraps in Axiom01's responsive table component.
 */
#}
{% if rows or header %}
  <div class="table-responsive">
    <table{{ attributes }}>
      {% if header %}
        <thead>
          <tr>
            {% for cell in header %}
              <th{{ cell.attributes }}>
                {{ cell.content }}
              </th>
            {% endfor %}
          </tr>
        </thead>
      {% endif %}
      <tbody>
        {% for row in rows %}
          <tr{{ row.attributes }}>
            {% for cell in row.cells %}
              <td{{ cell.attributes }}>
                {{ cell.content }}
              </td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% elseif empty %}
  <div class="alert">
    <p>{{ empty }}</p>
  </div>
{% endif %}
