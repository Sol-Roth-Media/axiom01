{#
/**
 * @file
 * Axiom01 override for the site branding block.
 */
#}
<div{{ attributes.addClass('site-branding') }}>
  {% if site_logo %}
    <a href="{{ path('<front>') }}" rel="home">
      <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" />
    </a>
  {% endif %}
  {% if site_name %}
    <a href="{{ path('<front>') }}" rel="home">
      <strong>{{ site_name }}</strong>
    </a>
  {% endif %}
  {% if site_slogan %}
    <p>{{ site_slogan }}</p>
  {% endif %}
</div>
