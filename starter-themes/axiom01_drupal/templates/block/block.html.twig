{#
/**
 * @file
 * Axiom01 override for generic blocks.
 *
 * Maps Drupal blocks to semantic elements.
 * block_content entities use <article>, system blocks use <section>.
 */
#}
{% set tag = configuration.provider == 'block_content' ? 'article' : 'section' %}
<{{ tag }}{{ attributes.addClass('block') }}>
  {% if label %}
    <header>
      {{ title_prefix }}
      <h2{{ title_attributes }}>{{ label }}</h2>
      {{ title_suffix }}
    </header>
  {% endif %}
  {% block content %}
    {{ content }}
  {% endblock %}
</{{ tag }}>
