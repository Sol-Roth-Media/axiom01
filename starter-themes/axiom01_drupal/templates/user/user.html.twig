{#
/**
 * @file
 * Axiom01 override for user profiles.
 *
 * Renders user profiles as semantic article cards.
 */
#}
<article{{ attributes.addClass('card', 'user-profile') }}>
  {% if content.user_picture %}
    <figure>
      {{ content.user_picture }}
    </figure>
  {% endif %}
  <header>
    {% if content.field_name|render|trim %}
      <h2>{{ content.field_name }}</h2>
    {% endif %}
  </header>
  {{ content|without('user_picture', 'field_name') }}
</article>
