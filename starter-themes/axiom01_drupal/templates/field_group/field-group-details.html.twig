{#
/**
 * @file
 * Axiom01 override for Field Group collapsible details.
 *
 * Maps to native HTML5 <details>/<summary>.
 */
#}
<details{{ attributes }}{% if open %} open{% endif %}>
  {% if title %}
    <summary>{{ title }}</summary>
  {% endif %}
  {% if description %}
    <small>{{ description }}</small>
  {% endif %}
  {{ children }}
</details>
